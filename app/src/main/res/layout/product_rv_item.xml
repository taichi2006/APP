<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="@color/brand_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/brand_border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp">

        <!-- Product Image Container -->
        <FrameLayout
            android:id="@+id/layout_product_img"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/img_product"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/brand_bg_warm"
                android:padding="8dp"
                android:scaleType="fitCenter"
                tools:src="@color/g_dark_blue" />

            <!-- Discount Percentage Badge floating on top-left -->
            <TextView
                android:id="@+id/tv_discount_badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_rounded_badge"
                android:backgroundTint="#E5C5382A"
                android:fontFamily="@font/sf_pro_display"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/white"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="-15%"
                tools:visibility="visible" />

            <!-- Favorite Icon floating on top-right -->
            <ImageView
                android:id="@+id/img_favorite"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/settings_items_background"
                android:backgroundTint="#CCFFFFFF"
                android:padding="6dp"
                android:src="@drawable/ic_favorite"
                app:tint="@color/g_blue_gray200" />
        </FrameLayout>

        <!-- Product Name (Fixed 2 lines height for neat alignment) -->
        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro"
            android:maxLines="2"
            android:textColor="@color/brand_text_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_product_img"
            tools:text="Ghế sofa hiện đại bọc nệm phòng khách cao cấp" />

        <!-- 3D AR & Badge Feature Row (Clear separation, never overlaps with discount badge on image) -->
        <LinearLayout
            android:id="@+id/layout_feature_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_name">

            <TextView
                android:id="@+id/tv_product_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display"
                android:textColor="@color/brand_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                tools:text="★ 4.9" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_sold_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display"
                android:textColor="@color/brand_text_muted"
                android:textSize="10.5sp"
                tools:text="Đã bán 128" />
        </LinearLayout>

        <!-- Price Section (Clean, uncluttered Shopee style) -->
        <LinearLayout
            android:id="@+id/layout_price_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_feature_row">

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display"
                android:textColor="@color/brand_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="1.600.000 đ" />

            <TextView
                android:id="@+id/tv_new_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/sf_pro_display"
                android:textColor="@color/brand_text_muted"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="2.000.000 đ"
                tools:visibility="visible" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="290dp"
    android:layout_height="124dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/brand_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/brand_border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Product Image Container -->
        <FrameLayout
            android:id="@+id/layout_img_container"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/img_special_rv_item"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/brand_bg_warm"
                android:padding="6dp"
                android:scaleType="fitCenter"
                tools:src="@color/g_dark_blue" />
        </FrameLayout>

        <!-- Product Name -->
        <TextView
            android:id="@+id/tv_special_product_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/brand_text_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/layout_img_container"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Ghế Thư Giãn Cao Cấp" />

        <!-- Price Row -->
        <LinearLayout
            android:id="@+id/layout_price_special"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_special_product_name"
            app:layout_constraintTop_toBottomOf="@id/tv_special_product_name">

            <TextView
                android:id="@+id/tv_special_product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/brand_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="2.520.000 đ" />

            <TextView
                android:id="@+id/tv_special_product_old_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/brand_text_muted"
                android:textSize="10sp"
                tools:text="3.200.000 đ" />
        </LinearLayout>

        <!-- Sold Count & Rating Row -->
        <LinearLayout
            android:id="@+id/layout_meta_special"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_special_product_name"
            app:layout_constraintTop_toBottomOf="@id/layout_price_special">

            <TextView
                android:id="@+id/tv_special_sold_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/brand_text_muted"
                android:textSize="10sp"
                tools:text="Đã bán 128" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="•"
                android:textColor="@color/brand_text_muted"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="★ 4.9"
                android:textColor="@color/brand_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Action Link -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/layout_img_container">

            <TextView
                android:id="@+id/btn_add_to_cart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Xem ngay ›"
                android:textColor="@color/brand_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

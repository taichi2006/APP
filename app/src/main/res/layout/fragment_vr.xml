<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <!-- Camera Preview SurfaceView (nền camera thực tế khi bật chế độ Camera) -->
    <SurfaceView
        android:id="@+id/cameraSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Chế độ xem mô hình 3D (SceneView) -->
    <com.google.ar.sceneform.SceneView
        android:id="@+id/sceneView3D"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Thanh tiêu đề điều khiển -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackVr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/settings_items_background"
            android:backgroundTint="#E6FFFFFF"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            app:tint="#0F172A" />

        <TextView
            android:id="@+id/tvVrTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_light"
            android:maxLines="1"
            android:text="Xem mô hình 3D"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnResetView"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/settings_items_background"
            android:backgroundTint="#E6FFFFFF"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_refresh"
            app:tint="#0F172A" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchMode"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:elevation="4dp"
            android:fontFamily="@font/poppins_light"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Xem qua Camera"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="20dp" />
    </LinearLayout>

    <!-- Thanh chọn màu trực tiếp cho mô hình 3D -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVrColors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="88dp"
        android:background="@drawable/settings_items_background"
        android:backgroundTint="#F2FFFFFF"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:visibility="gone" />

    <!-- Hướng dẫn cử chỉ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_items_background"
            android:backgroundTint="#E6FFFFFF"
            android:elevation="4dp"
            android:fontFamily="@font/poppins_light"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="1 ngón: xoay 360° &amp; nhìn từ trên xuống • 2 ngón: thu phóng &amp; di chuyển"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>

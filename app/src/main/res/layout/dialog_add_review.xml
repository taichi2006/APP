<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/brand_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="Đánh giá sản phẩm"
            android:textColor="@color/brand_text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_dialog_order_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/sf_pro_display"
            android:textColor="@color/brand_text_muted"
            android:textSize="12sp"
            tools:text="Đơn hàng #84920 • Đã nhận hàng thành công" />

        <!-- Star Rating -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <RatingBar
                android:id="@+id/rating_bar_input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:progressTint="#B88A44"
                android:rating="5"
                android:secondaryProgressTint="#B88A44"
                android:stepSize="1" />

            <TextView
                android:id="@+id/tv_rating_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/sf_pro_display"
                android:text="Tuyệt vời - Rất hài lòng"
                android:textColor="#B88A44"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Feedback Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_comment"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/brand_primary"
            app:hintTextColor="@color/brand_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ed_comment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display"
                android:gravity="top|start"
                android:hint="Cảm nhận của bạn về chất lượng và dịch vụ..."
                android:inputType="textMultiLine"
                android:lines="4"
                android:maxLines="6"
                android:textColor="@color/brand_text_dark"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_review"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/sf_pro_display"
                android:text="Bỏ qua"
                android:textAllCaps="false"
                android:textColor="@color/brand_text_muted"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit_review"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="@color/brand_primary"
                android:fontFamily="@font/sf_pro_display"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Gửi đánh giá"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

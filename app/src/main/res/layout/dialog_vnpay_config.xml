<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="85dp"
                android:layout_height="26dp"
                android:contentDescription="Logo VNPAY"
                android:src="@drawable/ic_vnpay_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rounded_badge"
                android:backgroundTint="#EFF6FF"
                android:fontFamily="@font/be_vietnam_pro"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="SANDBOX KEY"
                android:textColor="#005BAA"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="Cấu hình tài khoản VNPAY Sandbox"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="Nhập thông tin VNPAY Sandbox được cấp từ email sau khi đăng ký tại sandbox.vnpayment.vn:"
            android:textColor="#64748B"
            android:textSize="12.5sp"
            android:lineSpacingExtra="2dp" />

        <!-- Ô NHẬP TMN CODE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="Mã Website (vnp_TmnCode):"
            android:textColor="#334155"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etConfigTmnCode"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:fontFamily="@font/be_vietnam_pro"
            android:hint="YB3TI7G3"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#1E293B"
            android:textSize="13.5sp" />

        <!-- Ô NHẬP HASH SECRET -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="Chuỗi bí mật tạo chữ ký (vnp_HashSecret):"
            android:textColor="#334155"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etConfigHashSecret"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:fontFamily="@font/be_vietnam_pro"
            android:hint="Chuỗi bí mật (Secret Key) gồm 32 ký tự"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#1E293B"
            android:textSize="13sp" />

        <!-- NÚT LƯU VÀ MỞ CỔNG VNPAY -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveConfig"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="#005BAA"
            android:fontFamily="@font/be_vietnam_pro"
            android:stateListAnimator="@null"
            android:text="LƯU &amp; MỞ CỔNG VNPAY"
            android:textColor="@color/white"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelConfig"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:background="@android:color/transparent"
            android:fontFamily="@font/be_vietnam_pro"
            android:stateListAnimator="@null"
            android:text="Đóng"
            android:textColor="#64748B"
            android:textSize="13sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

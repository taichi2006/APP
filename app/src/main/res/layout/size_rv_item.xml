<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_size"
    android:layout_width="wrap_content"
    android:layout_height="42dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="#CBD5E1"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <!-- Hidden shadow / indicator for backward compatibility with SizesAdapter -->
        <View
            android:id="@+id/img_shadow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="invisible" />

        <View
            android:id="@+id/img_color"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro"
            android:maxLines="1"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Dài 180 × Rộng 80 × Cao 75 cm" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

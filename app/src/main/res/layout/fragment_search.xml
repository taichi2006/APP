<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg_warm">

    <!-- Top Header, Search Bar & Sort Options -->
    <LinearLayout
        android:id="@+id/layout_header_trending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_surface"
        android:elevation="3dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_title_top_selling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_light"
                android:text="Khám Phá Nội Thất"
                android:textColor="@color/brand_text_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_badge_top_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/settings_items_background"
                android:backgroundTint="#FAF3E8"
                android:fontFamily="@font/sf_pro_display"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="Bộ sưu tập TCFurnish"
                android:textColor="@color/brand_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/search_box_background">

            <EditText
                android:id="@+id/ed_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="@font/sf_pro_display"
                android:gravity="start|center_vertical"
                android:hint="Tìm kiếm bàn, ghế sofa, giường, tủ..."
                android:imeOptions="actionSearch"
                android:inputType="textCapWords"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="@color/brand_text_dark"
                android:textColorHint="@color/brand_text_muted"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/search_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/search_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_search"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/brand_primary" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Horizontal Sort Selection Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fadingEdge="horizontal"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_sort_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Chip 1: Bán chạy (default) -->
                <TextView
                    android:id="@+id/chip_sort_sold"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/settings_items_background"
                    android:backgroundTint="@color/brand_primary"
                    android:fontFamily="@font/sf_pro_display"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="🔥 Bán chạy nhất"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Chip 2: Giá thấp -> cao -->
                <TextView
                    android:id="@+id/chip_sort_price_asc"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/settings_items_background"
                    android:backgroundTint="#FAF3E8"
                    android:fontFamily="@font/sf_pro_display"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Giá: Thấp → Cao"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="12sp" />

                <!-- Chip 3: Giá cao -> thấp -->
                <TextView
                    android:id="@+id/chip_sort_price_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/settings_items_background"
                    android:backgroundTint="#FAF3E8"
                    android:fontFamily="@font/sf_pro_display"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Giá: Cao → Thấp"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="12sp" />

                <!-- Chip 4: Đánh giá cao -->
                <TextView
                    android:id="@+id/chip_sort_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/settings_items_background"
                    android:backgroundTint="#FAF3E8"
                    android:fontFamily="@font/sf_pro_display"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="★ Đánh giá cao"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="12sp" />

                <!-- Chip 5: Khuyến mãi sâu -->
                <TextView
                    android:id="@+id/chip_sort_discount"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/settings_items_background"
                    android:backgroundTint="#FAF3E8"
                    android:fontFamily="@font/sf_pro_display"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="% Giảm sâu"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="12sp" />

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_bar_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/brand_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header_trending" />

    <!-- RecyclerView of Products -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_rv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header_trending"
        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:listitem="@layout/product_rv_item"
        tools:spanCount="2" />

    <!-- Empty View -->
    <LinearLayout
        android:id="@+id/layout_empty_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header_trending">

        <TextView
            android:id="@+id/tv_empty_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_light"
            android:gravity="center"
            android:text="Không tìm thấy sản phẩm phù hợp"
            android:textColor="@color/brand_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

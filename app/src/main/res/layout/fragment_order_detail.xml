<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg_warm">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarOrderDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_surface"
        app:elevation="2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardBackOrder"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/brand_bg_warm"
                app:cardCornerRadius="19dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imageCloseOrder"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_close"
                    app:tint="@color/brand_text_dark" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@id/cardBackOrder"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="Chi tiết đơn hàng"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOrderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textColor="@color/brand_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Order #458921" />
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- 1. CARD: ORDER STATUS & TIMELINE (SHOPEE STYLE) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_truck_delivery"
                                app:tint="@color/brand_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:text="Trạng thái đơn hàng"
                                android:textColor="@color/brand_text_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Status Badge -->
                        <LinearLayout
                            android:id="@+id/layoutDetailStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/white_background"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp">

                            <TextView
                                android:id="@+id/tvDetailStatusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:text="Đã đặt"
                                android:textColor="@color/g_orange_yellow"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvStatusDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="Đơn hàng đã được ghi nhận vào hệ thống và đang được xử lý."
                        android:textColor="@color/brand_text_muted"
                        android:textSize="13sp" />

                    <!-- Shipping Courier & Tracking Code -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/brand_bg_warm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_all_orders"
                            app:tint="@color/brand_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="Vận chuyển: TCFurnish Express"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTrackingCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:textColor="@color/brand_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="ARVN458921" />
                    </LinearLayout>

                    <!-- StepView Timeline -->
                    <com.shuhart.stepview.StepView
                        android:id="@+id/stepView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:padding="8dp"
                        app:sv_animationType="Line"
                        app:sv_doneCircleColor="@color/brand_primary"
                        app:sv_doneCircleRadius="12dp"
                        app:sv_doneStepLineColor="@color/brand_primary"
                        app:sv_doneStepMarkColor="@color/white"
                        app:sv_doneTextColor="@color/brand_primary"
                        app:sv_nextStepLineColor="@color/brand_border"
                        app:sv_nextTextColor="@color/brand_text_muted"
                        app:sv_selectedCircleColor="@color/brand_primary"
                        app:sv_selectedCircleRadius="14dp"
                        app:sv_selectedStepNumberColor="@color/white"
                        app:sv_selectedTextColor="@color/brand_text_dark"
                        app:sv_stepLineWidth="3dp"
                        app:sv_stepNumberTextSize="12sp"
                        app:sv_stepPadding="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. CARD: SHIPPING ADDRESS (SHOPEE STYLE) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_location"
                            app:tint="@color/brand_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="Địa chỉ nhận hàng"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvFullName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Nguyễn Văn A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:text="•"
                            android:textColor="@color/brand_border" />

                        <TextView
                            android:id="@+id/tvPhoneNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/white_background"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="12sp"
                            tools:text="0987654321" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/brand_text_muted"
                        android:textSize="13sp"
                        tools:text="Số 123 Đường Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. CARD: PURCHASED PRODUCTS (SHOPEE STYLE) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_cart"
                                app:tint="@color/brand_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:text="Sản phẩm đã đặt"
                                android:textColor="@color/brand_text_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvProductsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:textColor="@color/brand_text_muted"
                            android:textSize="12sp"
                            tools:text="2 sản phẩm" />
                    </RelativeLayout>

                    <!-- Product List -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvProducts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="2"
                        tools:listitem="@layout/order_detail_product_item" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. CARD: E-INVOICE / RECEIPT SUMMARY -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_receipt_long"
                            app:tint="@color/brand_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="Hóa đơn thanh toán"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Invoice metadata table (Sử dụng LinearLayout chia cột weight, chống đè chữ tuyệt đối) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <!-- Mã đơn hàng -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:text="Mã đơn hàng"
                                android:textColor="@color/brand_text_muted"
                                android:textSize="13sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvInvoiceOrderId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:textColor="@color/brand_text_dark"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="#458921" />

                            <TextView
                                android:id="@+id/btnCopyOrderId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/white_background"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="Sao chép"
                                android:textColor="@color/brand_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Thời gian đặt hàng -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:text="Thời gian đặt hàng"
                                android:textColor="@color/brand_text_muted"
                                android:textSize="13sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvInvoiceDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:textColor="@color/brand_text_dark"
                                android:textSize="13sp"
                                tools:text="22/11/2026 15:30" />
                        </LinearLayout>

                        <!-- Phương thức thanh toán -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="125dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:text="Phương thức:"
                                android:textColor="@color/brand_text_muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvInvoicePaymentMethod"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:gravity="end"
                                android:textColor="@color/brand_text_dark"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="Thanh toán trực tuyến (Thẻ &amp; QR)" />
                        </LinearLayout>

                        <!-- Trạng thái thanh toán & Mã giao dịch -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="125dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:text="Trạng thái &amp; Mã GD:"
                                android:textColor="@color/brand_text_muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvInvoicePaymentStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:gravity="end"
                                android:lineSpacingExtra="2dp"
                                android:textColor="@color/brand_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="Đã thanh toán (Mã GD: #TXN819234)" />
                        </LinearLayout>

                        <!-- Ghi chú đơn hàng -->
                        <LinearLayout
                            android:id="@+id/layoutInvoiceNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="top"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="125dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:text="Ghi chú đơn hàng:"
                                android:textColor="@color/brand_text_muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvInvoiceNote"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:gravity="end"
                                android:textColor="@color/brand_text_dark"
                                android:textSize="13sp"
                                tools:text="Giao trong giờ hành chính" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/brand_border" />

                    <!-- Calculation Table (Đã bỏ phí vận chuyển, shop tự vận chuyển & lắp đặt) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="Tiền hàng (Tạm tính)"
                            android:textColor="@color/brand_text_muted"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvSubtotalPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="13sp"
                            tools:text="8.010.000 đ" />
                    </LinearLayout>

                    <!-- Note: Shop tự giao & lắp đặt miễn phí -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_rounded_badge"
                        android:backgroundTint="#F8FAFC"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_truck_delivery"
                            app:tint="@color/brand_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="Shop tự vận chuyển &amp; hỗ trợ lắp đặt miễn phí tận nơi (Giao trong vòng 7 ngày)"
                            android:textColor="@color/brand_primary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/brand_border" />

                    <!-- Total Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="Tổng thanh toán"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvTotalPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:textColor="@color/brand_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="8.010.000 đ" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 5. CARD: CUSTOMER SUPPORT & POLICY -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/brand_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="Chính sách &amp; Hỗ trợ đơn hàng"
                        android:textColor="@color/brand_text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:lineSpacingExtra="2dp"
                        android:text="• Đổi trả miễn phí trong vòng 30 ngày nếu lỗi sản xuất.\n• Hotline CSKH: 1900 8888 (08:30 - 21:30 hàng ngày)\n• Cảm ơn bạn đã lựa chọn mua sắm nội thất tại TCFurnish!"
                        android:textColor="@color/brand_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- SHOPEE STICKY BOTTOM ACTION BAR -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardBackgroundColor="@color/brand_surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelOrder"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/brand_danger_light"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Hủy đơn"
                android:textAllCaps="false"
                android:textColor="@color/brand_danger"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="22dp"
                app:strokeColor="@color/brand_danger"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRateOrder"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#B88A44"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Đánh giá"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReorder"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/brand_primary"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Mua lại"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:cornerRadius="22dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/brand_bg_warm"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/brand_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_review_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/brand_text_muted"
                android:textSize="11sp"
                tools:text="20/11/2026" />

            <TextView
                android:id="@+id/tv_reviewer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tv_review_date"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/brand_text_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Hoàng Minh Đức" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RatingBar
                android:id="@+id/rating_bar_item"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:isIndicator="true"
                android:numStars="5"
                android:progressTint="#B88A44"
                android:rating="5"
                android:secondaryProgressTint="#B88A44" />

            <TextView
                android:id="@+id/tv_rating_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="#B88A44"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="5.0" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_review_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/be_vietnam_pro"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/brand_text_dark"
            android:textSize="12sp"
            tools:text="Sản phẩm rất đẹp, đệm ngồi êm ái, màu sắc đúng y hình mẫu. Đội ngũ giao hàng lắp ráp nhanh nhẹn và chuyên nghiệp!" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

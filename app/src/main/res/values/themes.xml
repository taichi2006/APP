<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Warm Scandinavian / Interior Beige & Tea Brown Palette. -->
    <style name="Theme.ARoom" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color: Nâu trà sang trọng -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color: Gỗ sồi ấm -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnSecondary">@color/brand_text_dark</item>
        <!-- Status bar color & Window Background -->
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:windowBackground">@color/brand_bg_warm</item>
        <!-- Default Vietnamese-safe font family -->
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
    </style>
</resources>
